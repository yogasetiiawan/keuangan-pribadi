APP_NAME="Keuangan Pribadi API"
APP_ENV=local
APP_KEY=base64:KeuanganPribadiLaravelApiKey2026SecretKey123=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Default menggunakan SQLite agar langsung berjalan tanpa setup database tambahan.
# Jika ingin memakai MySQL (Laragon), ubah DB_CONNECTION=mysql dan aktifkan konfigurasi di bawah.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=keuangan_pribadi
# DB_USERNAME=root
# DB_PASSWORD=

# =========================================================================
# KONFIGURASI INTEGRASI GOOGLE SHEETS
# =========================================================================
# Opsi 1 (Paling Mudah): Menggunakan Google Apps Script Web App URL
# Lihat file: ../google-sheets-connector/Code.gs
GOOGLE_SHEETS_WEBHOOK_URL=

# Opsi 2 (Google Cloud Service Account API v4)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Transaksi
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=storage/app/google-service-account.json
GOOGLE_SHEETS_AUTO_SYNC=true
